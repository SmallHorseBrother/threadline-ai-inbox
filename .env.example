# Copy this file to .dev.vars for local development.
# The AI features are optional; without a key Threadline uses rule-based summaries.
THREADLINE_ANALYSIS_API_KEY=
THREADLINE_ANALYSIS_BASE_URL=https://api.deepseek.com
THREADLINE_ANALYSIS_MODEL=deepseek-chat

# Set this to the public HTTPS origin when enabling device connectors.
THREADLINE_SITE_URL=https://threadline.example.com

# Optional. Only needed when the deployment platform protects machine requests
# with a separate bypass token (for example, OpenAI Sites).
THREADLINE_SITES_BYPASS_TOKEN=
